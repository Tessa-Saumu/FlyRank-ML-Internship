  "reading": {
    "D1": "If top_band_share_of_population is large and observed_p_at_k ~ expected_p_at_k, the rule is not ranking; its top-K is a draw from a tie.",
    "D2": "If agreement_with_persistence is high and realised_over_persistence_median ~ 1, the label is largely the continuation of the last seven days.",
    "D3": "If a model beats acceleration_rule inside the momentum pool, models add ordering on top of momentum; otherwise they only re-derive it.",
    "D4": "The honest ML question. Compare model P@50 with healthy_base_rate and static_rule."
  }
